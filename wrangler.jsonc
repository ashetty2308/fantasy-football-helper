{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fantasy-planning-advice",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "ROSTER",
      "id": "your-kv-namespace-id"
    }
  ]
}
